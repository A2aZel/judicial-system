# docker compose --env-file .env.mac -f compose.mac.yaml up --build -d
APP_PORT=8000
JUDICIAL_AI_APP_ENV=development
JUDICIAL_AI_API_KEY=
JUDICIAL_AI_LOG_LEVEL=INFO

# This included CSV is entirely synthetic. A fresh clone needs no private data.
JUDICIAL_AI_CORPUS_PATH=/app/fixtures/synthetic_analysis.csv
# For a real CSV fallback, copy it below this host directory and use its /data path:
# JUDICIAL_AI_CORPUS_PATH=/data/sudact/analysis.csv
JUDICIAL_AI_DATA_DIR=./data

# Copy the complete processed directory to ./data/processed to enable real kNN.
# Dense retrieval additionally needs a compatible index and a nonempty narrative.
JUDICIAL_AI_DENSE_ENABLED=true

# A named volume is writable by the image's nonroot user. An existing host cache
# can be mounted instead, e.g. /Users/you/.cache/huggingface/hub (must be writable).
JUDICIAL_AI_MODEL_CACHE=model_cache
